# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskforge_db?schema=public"

# Authentication & JWT (Secret must be at least 32 characters)
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_chars_long"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=10

# Security & CORS (Comma-separated allowed origins, empty/no Origin allowed for mobile)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
TRUST_PROXY=false

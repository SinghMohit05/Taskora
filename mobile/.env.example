# ==============================================================================
# TaskForge Mobile Client Environment Variables
# ==============================================================================
# The mobile app communicates directly with the Express backend API.
# Choose the appropriate URL based on your development environment:
#
# 1. Android Emulator:
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#    (10.0.2.2 is the special alias provided by the Android emulator loopback to host localhost)
#
# 2. Physical Device (Expo Go / Development Build on the same Wi-Fi):
#    EXPO_PUBLIC_API_URL=http://192.168.1.X:5000
#    (Replace with your development machine's actual LAN IP address)
#
# 3. iOS Simulator:
#    EXPO_PUBLIC_API_URL=http://localhost:5000
#
# 4. Production:
#    EXPO_PUBLIC_API_URL=https://api.taskforge.com
#    (Always use secure HTTPS in production builds)
#
# CLEARTEXT TRAFFIC NOTICE:
# Android 9+ blocks cleartext HTTP traffic by default. Local development using HTTP
# requires 'usesCleartextTraffic: true' configured in app.json via 'expo-build-properties'.
# Production deployments MUST point to an HTTPS endpoint.
# ==============================================================================

EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

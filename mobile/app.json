{
  "expo": {
    "name": "Taskora",
    "slug": "taskora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "taskora",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0E17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskforge.pms"
    },
    "android": {
      "package": "com.taskforge.pms",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E17"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "686d0add-d1eb-43c7-b3b1-ee4fff39dbd4"
      }
    }
  }
}

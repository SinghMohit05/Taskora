{
  "name": "@taskforge/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "TaskForge Mobile Client (React Native + Expo Router + TypeScript)",
  "scripts": {
    "start": "expo start --lan -c",
    "tunnel": "expo start --tunnel -c",
    "start:local": "expo start --localhost -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-native-community/netinfo": "11.3.1",
    "@tanstack/react-query": "^5.59.0",
    "@taskforge/shared": "*",
    "axios": "^1.7.7",
    "expo": "^51.0.39",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.53.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3"
  }
}
